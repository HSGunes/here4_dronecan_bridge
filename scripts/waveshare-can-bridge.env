# waveshare-can-bridge.service icin ayarlar.
# Kurulum: sudo cp waveshare-can-bridge.env /etc/default/waveshare-can-bridge

BRIDGE=/home/gunes/robotaksi_ws/src/here4_dronecan_bridge/scripts/waveshare_socketcan_bridge.py
SERIAL_PORT=/dev/ttyUSB-here4
CAN_IF=can0

# CAN bitrate kodu: 0x01=1Mbps (Here4/DroneCAN varsayilani)
CAN_BAUD=0x01

# TX frame'leri arasi bekleme (ms). RTCM gecikmesini bu belirliyor.
# Saha olcumu: 2.0 -> FIXED ~100 s, 1.0 -> ~60 s. Cok dusurmek adaptorde
# frame kaybi yapabilir (crc_hata/dusen sayaclarindan izle).
TX_SLEEP_MS=1.0
